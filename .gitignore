# OS / editors
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# local dev ports used by the author's scripts
.devports

# Laravel backend
backend/vendor/
backend/.env
backend/.env.backup
backend/.phpunit.result.cache
backend/public/hot
backend/public/storage
backend/storage/*.key
# storage/ keeps its folder skeleton (the .gitignore files inside), never its contents
backend/storage/app/private/*
backend/storage/app/public/*
backend/storage/logs/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
!backend/storage/**/.gitignore
backend/public/index.html
backend/public/assets/
backend/public/sw.js
backend/public/workbox-*.js
backend/public/manifest.webmanifest
backend/public/registerSW.js

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.eslintcache
frontend/*.tsbuildinfo
*.log
