APP_NAME=OpenWhen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Tirane

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs no setup, but the pdo_sqlite extension must be present.
# For Postgres:  DB_CONNECTION=pgsql  DB_HOST=127.0.0.1  DB_PORT=5432
#                DB_DATABASE=openwhen  DB_USERNAME=...  DB_PASSWORD=...
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

OPENWHEN_DEFAULT_LOCALE=sq
OPENWHEN_DEFAULT_TIMEZONE=Europe/Tirane

# The thresholds that decide when this product is allowed to claim anything
# live in App\Services\OpenWindowEstimator as constants, not here: they are the
# promise the product makes rather than something to tune per install, and each
# one is pinned in a test. See the comments in config/openwhen.php.
