APP_NAME="OpenWhen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8114
# Where people open the web app (Vite in development). Links in messages point here.
APP_PUBLIC_URL=http://localhost:5114
# Seeds a sample organisation and enables the WhatsApp reply simulator.
APP_DEMO=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openwhen
DB_USERNAME=openwhen
DB_PASSWORD=openwhen

# Sessions last 30 days so a phone stays signed in.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# Hosts the SPA is served from; they get cookie sessions + CSRF (Laravel Sanctum).
SANCTUM_STATEFUL_DOMAINS=localhost:5114,127.0.0.1:5114,localhost:8114

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API (optional). Without it, messages stay in the in-app outbox.
MESSAGING_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Claude (optional) for reading photos. Without it, fields are typed by hand.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
